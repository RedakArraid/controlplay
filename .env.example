APP_ENV=development
# UI : avec Docker + volume ./app, exécuter « make frontend-build » (sinon 503 sur /, /login, /admin — voir docs/README).
# En dev (APP_ENV=development), le seed assure aussi admin@test.com (voir ensure_dev_admin). Mettre false pour désactiver.
# AUTO_ENSURE_DEV_ADMIN=true
# Obligatoire pour les cookies de session (/login, /admin). En prod : valeur longue et aléatoire.
APP_SECRET_KEY=change-me-in-prod
# Compte bootstrap (email ou téléphone) + mot de passe ; seed au 1er démarrage si aucun super_admin.
# Aligné avec les tests pytest / doc : même couple que make ensure-dev-admin
ADMIN_USERNAME=admin@test.com
ADMIN_PASSWORD=testpass123
# RBAC : super_admin et salle_admin global dans user_roles ; rôles par salle dans salle_users.
# Admins de salle : création de comptes gérants/responsables via /admin/mes-utilisateurs (created_by).
# make admin-salle-only : retire super_admin / admin / salle_admin global, puis salle_admin sur chaque salle (salle_users).

# Super administrateur global (optionnel) — créer/mettre à jour avec : make ensure-super-admin
# SUPER_ADMIN_EMAIL=superadmin@controlplay.com
# SUPER_ADMIN_PASSWORD=admin123
# SUPER_ADMIN_NAME=Super admin
# URL publique de l’app (callbacks PSP, liens). Adapter le port si APP_PORT ≠ 8000 (Compose ne résout pas ${APP_PORT} ici).
BASE_URL=http://localhost:8000

# Parcours client station : 1 = GET /s/{code} sert la SPA (React) ; 0 = page HTML serveur legacy
PUBLIC_STATION_SPA=1

APP_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
# Si ces ports sont déjà utilisés sur l’hôte, changez uniquement ces deux valeurs (ex. 55433 / 6381) et gardez DATABASE_URL / CELERY_* sur db:5432 et redis:6379.

DATABASE_URL=postgresql+psycopg2://controlplay:controlplay@db:5432/controlplay
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Broadlink RM Mini (pilotage TV / HDMI) — laissé en dry-run tant que vous priorisez vente / location sans matériel.
BROADLINK_IP=192.168.1.250
BROADLINK_DRY_RUN=true
IR_CODE_HDMI1=hdmi1_code_placeholder
IR_CODE_HDMI2=hdmi2_code_placeholder
IR_CODE_POWER=power_code_placeholder

# ── Paiements : Paystack (primaire) + CinetPay (backup) ── Voir docs/PSP_PAYSTACK_CINETPAY.md
BASE_URL doit être HTTPS accessible publiquement en prod (webhooks / retours PSP).

# Paystack — PAYSTACK_SECRET_KEY obligatoire pour init + verify ; PAYSTACK_WEBHOOK_SECRET fortement recommandé en prod
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=
# Devise et multiplicateur (ex. XOF ×100 ou NGN en kobo)
PAYSTACK_CURRENCY=XOF
PAYSTACK_AMOUNT_MULTIPLIER=100

# CinetPay — utilisé si Paystack échoue ou n’est pas configuré ; webhook valide x-token avec CINETPAY_SECRET_KEY
CINETPAY_API_KEY=api_key_xxx
CINETPAY_SITE_ID=site_id_xxx
CINETPAY_SECRET_KEY=secret_xxx

# App options
AUTO_CREATE_SCHEMA=false

